{
  "expo": {
    "name": "pi-primavera",
    "slug": "pi-primavera",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "piprimavera",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c8129401-687f-4dd1-a125-bf00ba538052"
      }
    },
    "owner": "afonsonferreira"
  }
}
